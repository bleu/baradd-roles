{
  "name": "@baradd/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Config types and TOML (de)serialization for Stellar Roles, shared by the CLI and the frontend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./apply": {
      "types": "./dist/apply/index.d.ts",
      "default": "./dist/apply/index.js"
    },
    "./scval": {
      "types": "./dist/scval/index.d.ts",
      "default": "./dist/scval/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "smart-account-kit": "^0.10.0",
    "smol-toml": "^1.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
