{
  "name": "@barad/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Config types and TOML (de)serialization for Stellar Roles, shared by the CLI and the frontend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
